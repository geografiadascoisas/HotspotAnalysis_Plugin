<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HotspotAnalysisDialogBase</class>
 <widget class="QDialog" name="HotspotAnalysisDialogBase">
  <property name="windowTitle">
   <string>Hotspot Analysis v3</string>
  </property>

  <layout class="QVBoxLayout" name="mainLayout">

   <!-- ========================================================= -->
   <!-- METHOD SELECTION                                           -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="methodGroup">
     <property name="title">
      <string>Select Analysis Method</string>
     </property>
     <layout class="QHBoxLayout" name="methodLayout">

      <item>
       <widget class="QRadioButton" name="checkBox_gi">
        <property name="text">
         <string>Local Getis-Ord Gi*</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QRadioButton" name="checkBox_moran">
        <property name="text">
         <string>Local Moran's I</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QRadioButton" name="checkBox_moranBi">
        <property name="text">
         <string>Bivariate Local Moran</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- INPUT LAYER                                               -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="inputGroup">
     <property name="title">
      <string>Input Layer</string>
     </property>

     <layout class="QGridLayout" name="inputLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="layer_label">
        <property name="text">
         <string>Select the input layer:</string>
        </property>
       </widget>
      </item>

      <item row="0" column="1">
       <widget class="QComboBox" name="comboBox"/>
      </item>
     </layout>

    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- ATTRIBUTE FIELDS                                           -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="fieldGroup">
     <property name="title">
      <string>Attribute Fields</string>
     </property>

     <layout class="QGridLayout" name="fieldLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="label">
        <property name="text">
         <string>Select attribute field (Y):</string>
        </property>
       </widget>
      </item>

      <item row="0" column="1">
       <widget class="QComboBox" name="comboBox_C"/>
      </item>

      <item row="1" column="0">
       <widget class="QLabel" name="label_4">
        <property name="text">
         <string>Select second attribute (X) – for Bivariate Moran:</string>
        </property>
       </widget>
      </item>

      <item row="1" column="1">
       <widget class="QComboBox" name="comboBox_C_2"/>
      </item>

     </layout>

    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- FIXED DISTANCE BAND                                        -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="fixedDistanceGroup">
     <property name="title">
      <string>Fixed Distance Band</string>
     </property>

     <layout class="QGridLayout" name="fixedDistanceLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="label_threshold">
        <property name="text">
         <string>Fixed Distance Band:</string>
        </property>
       </widget>
      </item>

      <item row="0" column="1">
       <widget class="QLineEdit" name="lineEditThreshold">
        <property name="placeholderText">
         <string>Auto-calculated if empty</string>
        </property>
        <property name="toolTip">
         <string>Minimum distance ensuring ≥1 neighbor (KDTree-estimated if empty)</string>
        </property>
       </widget>
      </item>

      <item row="1" column="0" colspan="2">
       <widget class="QLabel" name="label_2">
        <property name="text">
         <string>(Default = minimum distance ensuring ≥1 neighbor, estimated via KDTree)</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- DISTANCE OPTIMIZATION                                      -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="optGroup">
     <property name="title">
      <string>Distance Optimization (Moran’s I only)</string>
     </property>

     <layout class="QVBoxLayout" name="optLayout">

      <item>
       <widget class="QCheckBox" name="checkBox_optimizeDistance">
        <property name="text">
         <string>Optimize distance band (search for best Z-score)</string>
        </property>
       </widget>
      </item>

      <item>
       <layout class="QGridLayout" name="optGrid">

        <item row="0" column="0">
         <widget class="QLabel" name="label_7">
          <property name="text">
           <string>Min Distance:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="lineEdit_minT"/>
        </item>

        <item row="0" column="2">
         <widget class="QLabel" name="label_9">
          <property name="text">
           <string>Max Distance:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="3">
         <widget class="QLineEdit" name="lineEdit_maxT"/>
        </item>

        <item row="0" column="4">
         <widget class="QLabel" name="label_8">
          <property name="text">
           <string>Distance Step:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="5">
         <widget class="QLineEdit" name="lineEdit_dist"/>
        </item>

       </layout>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- WEIGHT MATRIX OPTIONS                                      -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="weightGroup">
     <property name="title">
      <string>Spatial Weight Matrix</string>
     </property>

     <layout class="QVBoxLayout" name="weightsLayout">

      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="checkBox_knn">
          <property name="text">
           <string>Use KNN matrix</string>
          </property>
         </widget>
        </item>

        <item>
         <widget class="QLineEdit" name="knn_number">
          <property name="text">
           <string>8</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <item>
       <widget class="QCheckBox" name="checkBox_queen">
        <property name="text">
         <string>Use Queen's case contiguity (polygons only)</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QCheckBox" name="checkBox_rowStandard">
        <property name="text">
         <string>Use row-standardized weights</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- PERMUTATION TESTS                                          -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="permGroup">
     <property name="title">
      <string>Significance Testing</string>
     </property>

     <layout class="QHBoxLayout" name="permLayout">

      <item>
       <widget class="QCheckBox" name="checkBox_randomPerm">
        <property name="text">
         <string>Use random permutations (Moran only)</string>
        </property>
       </widget>
      </item>

      <item>
       <widget class="QLineEdit" name="lineEdit_random">
        <property name="text">
         <string>999</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- OUTPUT                                                     -->
   <!-- ========================================================= -->
   <item>
    <widget class="QGroupBox" name="outputGroup">
     <property name="title">
      <string>Output File</string>
     </property>

     <layout class="QGridLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>Output filename (without .shp):</string>
        </property>
       </widget>
      </item>

      <item row="0" column="1">
       <widget class="QLineEdit" name="lineEdit"/>
      </item>

      <item row="0" column="2">
       <widget class="QPushButton" name="pushButton">
        <property name="text">
         <string>Browse</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ========================================================= -->
   <!-- BUTTON BOX                                                 -->
   <!-- ========================================================= -->
   <item>
    <widget class="QDialogButtonBox" name="button_box">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>

  </layout>
 </widget>

 <resources/>

 <!-- ========================================================= -->
 <!-- CONNECTIONS                   -->
 <!-- ========================================================= -->
 <connections>
  <connection>
   <sender>button_box</sender>
   <signal>accepted()</signal>
   <receiver>HotspotAnalysisDialogBase</receiver>
   <slot>accept()</slot>
  </connection>

  <connection>
   <sender>button_box</sender>
   <signal>rejected()</signal>
   <receiver>HotspotAnalysisDialogBase</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>

